# Dev loop configuration. Copy to .env and fill in; .env is gitignored. Never commit or share it.
# Setup guide: docs/DEVELOPMENT.md

# API key pair from Onshape: user icon > My account > Developer > Create new API key
# (scopes: read and write documents only).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Onshape server; change only for an enterprise domain.
ONSHAPE_BASE_URL=https://cad.onshape.com

# Test document, from its URL: https://cad.onshape.com/documents/<DID>/w/<WID>/e/<element id>
ONSHAPE_DID=
ONSHAPE_WID=

# Element ids: the test Part Studio and the "Knurl" Feature Studio (open the tab, copy the id after /e/).
ONSHAPE_PS_EID=
ONSHAPE_FS_EID=
